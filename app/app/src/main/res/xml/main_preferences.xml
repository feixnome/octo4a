<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference
            app:title="@string/pref_install_plugin_extras"
            app:key="installPluginExtras"
            app:iconSpaceReserved="false"
            app:summary="@string/pref_install_plugin_extras_summary" />
    <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="enableBugReporting"
            app:defaultValue="false"
            app:title="@string/pref_enable_bug_reporting"
            app:summary="@string/pref_enable_bug_reporting_summary"/>
    <PreferenceCategory
            app:title="@string/pref_server_settings"
            app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="enableSSH"
            app:summary="@string/pref_ssh_summary"
            app:title="@string/pref_ssh" />
        <EditTextPreference
                app:dependency="enableSSH"
                app:key="changeSSHPassword"
                app:iconSpaceReserved="false"
                app:singleLineTitle="false"
                app:title="@string/pref_ssh_password"/>
        <EditTextPreference
                app:dependency="enableSSH"
                app:key="sshPort"
                app:iconSpaceReserved="false"
                app:defaultValue="8022"
                app:singleLineTitle="false"
                app:title="@string/pref_ssh_port"/>
        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:singleLineTitle="false"
                app:key="startOnBoot"
                app:title="@string/pref_start_on_boot"
                app:defaultValue="false"
                app:summary="@string/pref_start_on_boot_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
            app:title="@string/pref_camera_settings"
            app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:singleLineTitle="false"
                app:key="enableCameraServer"
                app:title="@string/pref_enable_camera"
                app:summary="@string/pref_enable_camera_summary"/>
        <ListPreference
                app:iconSpaceReserved="false"
                app:key="selectedCamera"
                app:dependency="enableCameraServer"
                app:title="@string/pref_camera_source"
                app:summary="%s"/>
        <ListPreference
                app:iconSpaceReserved="false"
                app:key="selectedResolution"
                app:dependency="enableCameraServer"
                app:title="@string/pref_camera_resolution_snapshot"
                app:summary="%s"/>
        <ListPreference
                app:iconSpaceReserved="false"
                app:key="selectedVideoResolution"
                app:dependency="enableCameraServer"
                app:title="@string/pref_camera_resolution_video"
                app:summary="%s"/>

        <ListPreference
                app:iconSpaceReserved="false"
                app:key="imageRotation"
                app:entries="@array/rotation_settings"
                app:entryValues="@array/rotation_settings_values"
                app:dependency="enableCameraServer"
                app:defaultValue="0"
                app:title="@string/pref_image_rotation"
                app:summary="%s"/>


        <ListPreference
                app:iconSpaceReserved="false"
                app:key="fpsLimit"
                app:entries="@array/limit_fps"
                app:entryValues="@array/limit_fps_values"
                app:dependency="enableCameraServer"
                app:defaultValue="-1"
                app:title="@string/pref_camera_fps"
                app:summary="@string/pref_camera_fps_summary"/>
        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:key="flashWhenObserved"
                app:dependency="enableCameraServer"
                app:defaultValue="false"
                app:title="@string/pref_flash"
                app:summary="@string/pref_flash_summary"/>
        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:key="manualAF"
                app:dependency="enableCameraServer"
                app:defaultValue="false"
                app:title="@string/camera_preview_manual_af"
                app:summary="@string/pref_manual_focus_summary"/>
    </PreferenceCategory>


</PreferenceScreen>
